# Arc Network (NETWORK sets RPC, chain ID, explorer and token addresses)
NETWORK=testnet           # testnet | mainnet
# ARC_RPC / CHAIN_ID / EXPLORER_URL override the preset
ARC_RPC=https://rpc.testnet.arc.io
CHAIN_ID=5042002

# Admin owner (REQUIRED: admin dashboard stays disabled if unset)
OWNER_ADDRESS=0xYourOwnerWalletAddress
PUBLIC_DOMAIN=kudiarc.xyz
# OWNER_PRIVATE_KEY is only for local deploy scripts. Never set it on the server.

# Contracts
KUDI_CONTRACT_ADDRESS=0x8a10D0e61201000B5456EC725165892B08832C5f

# Server
PORT=5001
DB_PATH=/home/ubuntu/.kudi-data/kudi.db   # SQLite file, kept outside the project folder

# KudiSend escrow (v2)
ESCROW_ADDRESS=0xYourDeployedKudiSendEscrow
SEND_MODE=mock            # "live" enables real payouts; anything else = sandbox
QUOTE_TTL_SECONDS=600
SEND_MIN_USD=10
SEND_MAX_USD=50
# USDC_ADDRESS / EURC_ADDRESS / EXPLORER_URL default to Arc Testnet values

# Payout partners (keys are only used when SEND_MODE=live)
FLUTTERWAVE_SECRET_KEY=mock
BITNOB_BASE_URL=https://sandboxapi.bitnob.co/api/v1
BITNOB_SECRET_KEY=mock
PAYSTACK_SECRET_KEY=mock

# Webhook secrets (set all of these in production)
FLW_WEBHOOK_SECRET=
BITNOB_WEBHOOK_SECRET=

